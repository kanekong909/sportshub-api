# Base de datos Railway PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-seguro-min-32-chars"
JWT_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development

# APIs Deportivas
API_SPORTS_KEY="tu-api-key-de-api-sports.com"
THE_SPORTS_DB_KEY="tu-api-key-de-thesportsdb.com"

# Cloudinary (opcional — si no se configura, las imágenes se guardan localmente)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
